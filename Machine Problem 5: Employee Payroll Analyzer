import java.util.Scanner;
 
class Employee {
    private String employeeId;
    private String name;
    private double hoursWorked;
    private double hourlyRate;
 
    private static int employeeCount = 0;
 
    public Employee(String employeeId, String name,
                    double hoursWorked, double hourlyRate) {
 
        if (hoursWorked < 0 || hourlyRate < 0) {
            throw new IllegalArgumentException(
                "Hours and hourly rate cannot be negative."
            );
        }
 
        this.employeeId = employeeId;
        this.name = name;
        this.hoursWorked = hoursWorked;
        this.hourlyRate = hourlyRate;
 
        employeeCount++;
    }
 
    public String getEmployeeId() {
        return employeeId;
    }
 
    public String getName() {
        return name;
    }
 
    public double getHoursWorked() {
        return hoursWorked;
    }
 
    public double getHourlyRate() {
        return hourlyRate;
    }
 
    public static int getEmployeeCount() {
        return employeeCount;
    }
 
    public double getGrossPay() {
        if (hoursWorked <= 40) {
            return hoursWorked * hourlyRate;
        }
 
        double regularPay = 40 * hourlyRate;
        double overtimeHours = hoursWorked - 40;
        double overtimePay = overtimeHours * hourlyRate * 1.5;
 
        return regularPay + overtimePay;
    }
 
    public double getTax() {
        double grossPay = getGrossPay();
 
        if (grossPay <= 10000) {
            return grossPay * 0.05;
        } else if (grossPay <= 20000) {
            return grossPay * 0.10;
        } else {
            return grossPay * 0.15;
        }
    }
 
    public double getNetPay() {
        return getGrossPay() - getTax();
    }
}
 
public class EmployeePayrollAnalyzer {
    private static final Scanner scanner = new Scanner(System.in);
 
    public static void main(String[] args) {
        System.out.println("=== EMPLOYEE PAYROLL ANALYZER ===");
 
        int numberOfEmployees = readIntInRange(
            "Number of employees (1-10): ", 1, 10
        );
 
        Employee[] employees =
            new Employee[numberOfEmployees];
 
        for (int i = 0; i < employees.length; i++) {
            System.out.println("\nEmployee " + (i + 1));
 
            String employeeId =
                readNonEmpty("Employee ID: ");
 
            while (findEmployee(employees, employeeId) != null) {
                System.out.println(
                    "That employee ID already exists."
                );
 
                employeeId = readNonEmpty(
                    "Enter another employee ID: "
                );
            }
 
            String name = readNonEmpty("Full name: ");
 
            double hoursWorked = readNonNegativeDouble(
                "Hours worked: "
            );
 
            double hourlyRate = readNonNegativeDouble(
                "Hourly rate: PHP "
            );
 
            employees[i] = new Employee(
                employeeId,
                name,
                hoursWorked,
                hourlyRate
            );
        }
 
        System.out.println("\n=== PAYROLL SUMMARY ===");
 
        System.out.printf(
            "%-10s %-22s %10s %12s %12s%n",
            "ID", "NAME", "GROSS", "TAX", "NET PAY"
        );
 
        System.out.println(
            "--------------------------------------------------------------------"
        );
 
        Employee highestPaidEmployee = employees[0];
        double totalNetPay = 0;
 
        for (Employee employee : employees) {
            double grossPay = employee.getGrossPay();
            double tax = employee.getTax();
            double netPay = employee.getNetPay();
 
            System.out.printf(
                "%-10s %-22s %10.2f %12.2f %12.2f%n",
                employee.getEmployeeId(),
                employee.getName(),
                grossPay,
                tax,
                netPay
            );
 
            totalNetPay += netPay;
 
            if (netPay > highestPaidEmployee.getNetPay()) {
                highestPaidEmployee = employee;
            }
        }
 
        double averageNetPay =
            totalNetPay / employees.length;
 
        System.out.println(
            "\nHighest net pay: "
            + highestPaidEmployee.getName()
        );
 
        System.out.printf(
            "Amount: PHP %.2f%n",
            highestPaidEmployee.getNetPay()
        );
 
        System.out.printf(
            "Average net pay: PHP %.2f%n",
            averageNetPay
        );
 
        System.out.println(
            "Employee objects created: "
            + Employee.getEmployeeCount()
        );
    }
 
    private static Employee findEmployee(
            Employee[] employees, String employeeId) {
 
        for (Employee employee : employees) {
            if (employee != null
                    && employee.getEmployeeId()
                    .equalsIgnoreCase(employeeId)) {
 
                return employee;
            }
        }
 
        return null;
    }
 
    private static String readNonEmpty(String prompt) {
        while (true) {
            System.out.print(prompt);
            String value = scanner.nextLine().trim();
 
            if (!value.isEmpty()) {
                return value;
            }
 
            System.out.println("Input cannot be empty.");
        }
    }
 
    private static int readIntInRange(
            String prompt, int minimum, int maximum) {
 
        while (true) {
            System.out.print(prompt);
            String input = scanner.nextLine().trim();
 
            try {
                int value = Integer.parseInt(input);
 
                if (value >= minimum && value <= maximum) {
                    return value;
                }
            } catch (NumberFormatException error) {
                // Continue and display the message below.
            }
 
            System.out.println(
                "Please enter a whole number from "
                + minimum + " to " + maximum + "."
            );
        }
    }
 
    private static double readNonNegativeDouble(
            String prompt) {
 
        while (true) {
            System.out.print(prompt);
            String input = scanner.nextLine().trim();
 
            try {
                double value = Double.parseDouble(input);
 
                if (value >= 0) {
                    return value;
                }
            } catch (NumberFormatException error) {
                // Continue and display the message below.
            }
 
            System.out.println(
                "Please enter 0 or a positive number."
            );
        }
    }
}
